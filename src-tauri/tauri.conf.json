{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aichat Updater",
  "version": "0.1.0",
  "identifier": "com.cjdropshipping.aichat-updater",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aichat 插件更新工具",
        "width": 600,
        "height": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQTAzNjg0NTRFRkM3NDkKUldSSngrOVVoRGFnSVhMdUt5WjZQeDFSOGlXTDNDbm5zUzkyaHlUQ3R6NE1TWDZvcTdKT2xMSXgK",
      "endpoints": [
        "https://chainai.cjdropshipping.cn/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
